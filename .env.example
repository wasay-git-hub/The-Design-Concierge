# OpenAI API configuration (Required for live GPT Vision and LangGraph agent chat)
OPENAI_API_KEY=your_openai_api_key

# Langfuse Configuration
# Sign up at cloud.langfuse.com to get these keys for dashboard analytics
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=your_langfuse_base_url

# Database Connection String
DATABASE_URL=postgresql://user:password@host/dbname

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# A random long string to encrypt cookies, don't use quotation marks or spaces (e.g. super-secret-jwt-key)
NEXTAUTH_SECRET=my-random-secret-key-123

# The list of emails allowed to log in (no spaces, separated by commas)
ALLOWED_EMAILS=yourname@gmail.com,boss@agency.com